# Copy to .env and fill in before launch. Values prefixed PUBLIC_ are exposed
# to the browser — never put secrets in a PUBLIC_ variable.

# Production origin, e.g. https://www.example.com — enables canonical URLs,
# absolute Open Graph URLs and the XML sitemap.
PUBLIC_SITE_URL=

# Endpoint that receives enquiry submissions (JSON POST). See README → Lead capture.
PUBLIC_LEAD_ENDPOINT=

# Official business contact details. Leave blank until confirmed — the site
# hides call / WhatsApp / email actions while these are empty.
# E.164 format, e.g. +91XXXXXXXXXX
PUBLIC_PHONE=
PUBLIC_WHATSAPP=
PUBLIC_EMAIL=

# Footer contact notes — fill only with confirmed, approved wording.
# e.g. "Mon – Sat, 9:30 AM – 6:30 PM" / "Jaipur, Rajasthan, India"
PUBLIC_BUSINESS_HOURS=
PUBLIC_EMAIL_NOTE=
PUBLIC_LOCATION=
PUBLIC_LOCATION_NOTE=

# Official social profile URLs (full https:// links). Unset profiles are hidden.
PUBLIC_SOCIAL_LINKEDIN=
PUBLIC_SOCIAL_INSTAGRAM=
PUBLIC_SOCIAL_YOUTUBE=
PUBLIC_SOCIAL_FACEBOOK=
PUBLIC_SOCIAL_X=

# Optional analytics: Google Tag Manager container ID (GTM-XXXXXXX).
PUBLIC_GTM_ID=

# --- Server-side only (used by server/lead-handler.ts, never sent to the browser)
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
