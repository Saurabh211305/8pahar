---
import Logo from './brand/Logo.astro';
import CtaLink from './ui/CtaLink.astro';
import Icon from './ui/Icon.astro';

const nav = [
  { label: 'Services', href: '#services' },
  { label: 'Industries', href: '#industries' },
  { label: 'How It Works', href: '#how-it-works' },
  { label: 'FAQ', href: '#faq' },
];
const isHome = Astro.url.pathname === '/';
const prefix = isHome ? '' : '/';
---
<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="site-header__brand" href={isHome ? '#top' : '/'} aria-label="8PAHAR — Intelligent Security Systems, home">
      <Logo />
    </a>

    <nav class="site-nav" id="site-nav" aria-label="Main" data-nav>
      <ul role="list" class="site-nav__list">
        {nav.map((item) => (
          <li><a class="site-nav__link" href={`${prefix}${item.href}`}>{item.label}</a></li>
        ))}
      </ul>
      <CtaLink class="site-nav__cta" cta={{ label: 'Book a Security Audit', href: `${prefix}#audit`, requirement: 'security-audit', source: 'header' }} />
    </nav>

    <button class="site-header__toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      <span class="visually-hidden" data-nav-toggle-label>Open menu</span>
      <Icon name="menu" size={22} class="icon-open" />
      <Icon name="close" size={22} class="icon-close" />
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(244, 239, 231, 0.9);
    backdrop-filter: saturate(140%) blur(12px);
    -webkit-backdrop-filter: saturate(140%) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s var(--ease);
  }
  .site-header.is-scrolled {
    border-bottom-color: var(--line);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: var(--header-h);
  }
  .site-header__brand {
    display: inline-flex;
    padding-block: 6px;
    text-decoration: none;
  }
  .site-header__brand :global(.logo__mark img) {
    height: 40px;
  }
  .site-header__brand :global(.logo__word) {
    width: 104px;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: clamp(20px, 3vw, 40px);
  }
  .site-nav__list {
    display: flex;
    gap: clamp(18px, 2.4vw, 32px);
  }
  .site-nav__link {
    position: relative;
    display: inline-block;
    padding-block: 10px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }
  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4px;
    height: 1px;
    background: var(--terracotta);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }
  .site-nav__link:hover {
    color: var(--ink);
  }
  .site-nav__link:hover::after {
    transform: scaleX(1);
  }
  .site-nav :global(.site-nav__cta) {
    min-height: 46px;
    padding: 10px 18px;
  }

  /* Neumorphic toggle — a small, tactile control on the ivory header. */
  .site-header__toggle {
    display: none;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 12px;
    background: var(--ivory);
    color: var(--onyx);
    box-shadow:
      4px 4px 10px rgba(17, 18, 18, 0.12),
      -4px -4px 10px rgba(255, 255, 255, 0.85);
    cursor: pointer;
  }
  .site-header__toggle[aria-expanded='true'] {
    box-shadow:
      inset 3px 3px 8px rgba(17, 18, 18, 0.14),
      inset -3px -3px 8px rgba(255, 255, 255, 0.9);
  }
  .site-header__toggle :global(.icon-close),
  .site-header__toggle[aria-expanded='true'] :global(.icon-open) {
    display: none;
  }
  .site-header__toggle[aria-expanded='true'] :global(.icon-close) {
    display: block;
  }

  @media (max-width: 960px) {
    .site-header__toggle {
      display: grid;
    }
    .site-nav {
      position: fixed;
      inset: var(--header-h) 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      gap: 24px;
      padding: 16px var(--gutter) 28px;
      background: var(--ivory);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 24px 40px -24px rgba(17, 18, 18, 0.3);
      max-height: calc(100dvh - var(--header-h));
      overflow-y: auto;
    }
    /* Hidden by default only when JS is available to open it. */
    :global(.js) .site-nav:not(.is-open) {
      display: none;
    }
    :global(html:not(.js)) .site-nav {
      position: static;
      box-shadow: none;
      border: 0;
      padding: 0 0 16px;
    }
    :global(html:not(.js)) .site-header__toggle {
      display: none;
    }
    :global(html:not(.js)) .site-header__inner {
      flex-wrap: wrap;
    }
    .site-nav__list {
      flex-direction: column;
      gap: 0;
    }
    .site-nav__link {
      display: block;
      padding-block: 14px;
      font-size: 1.125rem;
      border-bottom: 1px solid var(--line);
    }
    .site-nav__link::after {
      display: none;
    }
  }
</style>
