---
import { methodology } from '../../content/site';
import CtaLink from '../ui/CtaLink.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import MethodologyEight from '../illustrations/MethodologyEight.astro';
---
<section class="section surface-onyx on-dark method" id="approach" aria-labelledby="method-title">
  <div class="container">
    <div class="method__head">
      <SectionHeading id="method-title" eyebrow={methodology.eyebrow} title={methodology.title} />
      <p class="lede">{methodology.lede}</p>
    </div>

    <div class="method__body">
      <figure class="method__figure">
        <MethodologyEight class="method__eight" stages={methodology.stages.map((s) => s.name)} />
        <figcaption class="method__caption">Assess → Design → Deploy → Detect → Monitor → Respond → Maintain → Protect</figcaption>
      </figure>

      <ol role="list" class="method__list">
        {methodology.stages.map((stage, i) => (
          <li class="method__stage">
            <span class="method__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="method__name">{stage.name}</h3>
            <p class="method__text">{stage.text}</p>
          </li>
        ))}
      </ol>
    </div>

    <div class="method__foot">
      <p class="note">{methodology.note}</p>
      <div class="cta-row">
        <CtaLink cta={methodology.primary} />
        <CtaLink cta={methodology.secondary} variant="secondary" />
        <CtaLink cta={methodology.link} variant="link" />
      </div>
    </div>
  </div>
</section>

<style>
  .method {
    overflow: hidden;
  }
  .method__head {
    display: grid;
    gap: 24px;
    align-items: end;
    margin-bottom: clamp(48px, 6vw, 80px);
  }
  @media (min-width: 960px) {
    .method__head {
      grid-template-columns: 1.3fr 1fr;
      gap: 64px;
    }
  }
  .method__body {
    display: grid;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .method__body {
      grid-template-columns: minmax(300px, 0.75fr) minmax(0, 1.5fr);
    }
  }
  .method__figure {
    display: grid;
    justify-items: center;
    gap: 16px;
    color: var(--ivory);
  }
  .method__figure :global(.method__eight) {
    width: 100%;
    max-width: 380px;
    height: auto;
  }
  @media (max-width: 639px) {
    .method__figure :global(.method__eight) {
      max-width: 300px;
    }
  }
  .method__caption {
    max-width: 30ch;
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    text-align: center;
    color: var(--on-dark-muted);
  }
  .method__list {
    display: grid;
    border-top: 1px solid var(--line-dark);
  }
  @media (min-width: 640px) {
    .method__list {
      grid-template-columns: 1fr 1fr;
      column-gap: clamp(24px, 3vw, 48px);
      grid-auto-flow: column;
      grid-template-rows: repeat(4, auto);
    }
  }
  .method__stage {
    display: grid;
    grid-template-columns: 44px 1fr;
    column-gap: 12px;
    row-gap: 4px;
    padding-block: 20px;
    border-bottom: 1px solid var(--line-dark);
  }
  .method__num {
    grid-row: span 2;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--terracotta-light);
    font-feature-settings: 'lnum';
    padding-top: 2px;
  }
  .method__name {
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 1.2rem + 0.5vw, 1.6rem);
    font-weight: 430;
    line-height: 1.2;
  }
  .method__text {
    color: var(--on-dark-muted);
    font-size: var(--fs-small);
    line-height: 1.6;
  }
  .method__foot {
    display: grid;
    gap: 24px;
    margin-top: clamp(40px, 5vw, 64px);
    padding-top: 32px;
    border-top: 1px solid var(--line-dark);
  }
  @media (min-width: 1024px) {
    .method__foot {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 48px;
    }
  }
</style>
