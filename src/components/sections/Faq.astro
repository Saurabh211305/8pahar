---
import { getFaqs } from '../../content/faq';
import { telHref, whatsappHref } from '../../config/business';
import CtaLink from '../ui/CtaLink.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';

const faqs = getFaqs();
const wa = whatsappHref('Hello 8PAHAR, I have a question about security for my property.');
---
<section class="section surface-ivory faq" id="faq" aria-labelledby="faq-title">
  <div class="container faq__grid">
    <div class="faq__aside">
      <SectionHeading
        id="faq-title"
        eyebrow="Frequently asked questions"
        title="Everything You Need to Know Before Getting Started."
        lede="Straight answers about audits, installation, AI surveillance and maintenance. If your question isn’t here, ask us directly."
      />
      <div class="faq__actions">
        <CtaLink cta={{ label: 'Book a Security Audit', href: '#audit', requirement: 'security-audit', source: 'faq' }} block />
        {telHref && (
          <a class="btn btn--secondary btn--block" href={telHref} data-contact="phone" data-cta-source="faq">
            <Icon name="phone" /><span>Call Our Team</span>
          </a>
        )}
        {wa && (
          <a class="btn btn--secondary btn--block" href={wa} target="_blank" rel="noopener noreferrer" data-contact="whatsapp" data-cta-source="faq">
            <Icon name="whatsapp" /><span>WhatsApp Your Question</span>
          </a>
        )}
        {!telHref && !wa && <CtaLink cta={{ label: 'Ask Our Team a Question', href: '#enquiry', requirement: 'question', source: 'faq' }} variant="secondary" block />}
      </div>
    </div>

    <div class="faq__list">
      {faqs.map((faq) => (
        <details class="faq__item" id={faq.id} data-faq>
          <summary class="faq__question">
            <span>{faq.question}</span>
            <span class="faq__icon" aria-hidden="true"><Icon name="plus" size={18} /></span>
          </summary>
          <div class="faq__answer">
            {faq.answer.map((p) => <p>{p}</p>)}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    gap: clamp(40px, 5vw, 72px);
  }
  @media (min-width: 1024px) {
    .faq__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-items: start;
    }
    .faq__aside {
      position: sticky;
      top: calc(var(--header-h) + 24px);
    }
  }
  .faq__actions {
    display: grid;
    gap: 12px;
    margin-top: 32px;
    max-width: 360px;
  }
  .faq__list {
    border-top: 1px solid var(--line-strong);
  }
  .faq__item {
    border-bottom: 1px solid var(--line-strong);
    scroll-margin-top: calc(var(--header-h) + 24px);
  }
  .faq__question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding-block: 22px;
    font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem);
    font-weight: 650;
    line-height: 1.4;
    cursor: pointer;
    list-style: none;
  }
  .faq__question::-webkit-details-marker {
    display: none;
  }
  .faq__question:hover {
    color: var(--green);
  }
  /* Neumorphic toggle: soft raised disc that presses in when the answer is open. */
  .faq__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--ivory);
    box-shadow:
      3px 3px 8px rgba(17, 18, 18, 0.12),
      -3px -3px 8px rgba(255, 255, 255, 0.9);
    transition:
      transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }
  .faq__item[open] .faq__icon {
    transform: rotate(45deg);
    box-shadow:
      inset 2px 2px 6px rgba(17, 18, 18, 0.14),
      inset -2px -2px 6px rgba(255, 255, 255, 0.9);
    color: var(--terracotta-ink);
  }
  .faq__answer {
    display: grid;
    gap: 12px;
    padding: 0 64px 26px 0;
    color: var(--ink-soft);
    line-height: 1.7;
    max-width: 70ch;
  }
  @media (max-width: 639px) {
    .faq__answer {
      padding-right: 0;
    }
  }
</style>
