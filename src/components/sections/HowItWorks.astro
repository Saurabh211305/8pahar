---
import { howItWorks } from '../../content/site';
import CtaLink from '../ui/CtaLink.astro';
import SectionHeading from '../ui/SectionHeading.astro';
---
<section class="section surface-ivory how" id="how-it-works" aria-labelledby="how-title">
  <div class="container">
    <div class="how__head">
      <SectionHeading id="how-title" eyebrow={howItWorks.eyebrow} title={howItWorks.title} />
      <p class="note">{howItWorks.note}</p>
    </div>

    <ol role="list" class="how__steps">
      {howItWorks.steps.map((step, i) => (
        <li class="how__step">
          <div class="how__marker" aria-hidden="true">
            <span class="how__num">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <h3 class="h3 how__title">{step.title}</h3>
          <p class="how__text">{step.text}</p>
          <p class="how__you"><span>Your part</span>{step.you}</p>
        </li>
      ))}
    </ol>

    <div class="cta-row how__ctas">
      <CtaLink cta={howItWorks.primary} />
      <CtaLink cta={howItWorks.secondary} variant="secondary" />
      <CtaLink cta={howItWorks.link} variant="link" />
    </div>
  </div>
</section>

<style>
  .how__head {
    display: grid;
    gap: 24px;
    align-items: end;
    margin-bottom: clamp(48px, 6vw, 80px);
  }
  @media (min-width: 960px) {
    .how__head {
      grid-template-columns: 1.4fr 1fr;
      gap: 64px;
    }
  }
  .how__steps {
    display: grid;
    gap: 0;
  }
  .how__step {
    position: relative;
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 0 0 36px 64px;
  }
  /* Vertical rule (mobile/tablet) */
  .how__step::before {
    content: '';
    position: absolute;
    left: 21px;
    top: 44px;
    bottom: 0;
    width: 1px;
    background: var(--line-strong);
  }
  .how__step:last-child::before {
    display: none;
  }
  .how__marker {
    position: absolute;
    left: 0;
    top: 0;
  }
  .how__num {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--onyx);
    background: var(--ivory);
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-feature-settings: 'lnum';
  }
  .how__step:first-child .how__num {
    background: var(--green);
    border-color: var(--green);
    color: var(--ivory);
  }
  @media (min-width: 1024px) {
    .how__steps {
      grid-template-columns: repeat(5, 1fr);
      gap: clamp(20px, 2.4vw, 36px);
    }
    .how__step {
      padding: 68px 0 0;
    }
    /* Horizontal rule linking the markers */
    .how__step::before {
      left: 52px;
      right: calc(-1 * clamp(20px, 2.4vw, 36px));
      top: 22px;
      bottom: auto;
      width: auto;
      height: 1px;
    }
  }
  .how__text {
    color: var(--ink-soft);
    font-size: var(--fs-small);
    line-height: 1.6;
  }
  .how__you {
    display: grid;
    gap: 2px;
    margin-top: 6px;
    padding-top: 12px;
    border-top: 1px dashed var(--line-strong);
    font-size: var(--fs-xs);
    line-height: 1.5;
    color: var(--ink-muted);
  }
  .how__you span {
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.6875rem;
    color: var(--terracotta-ink);
  }
  .how__ctas {
    margin-top: clamp(24px, 4vw, 48px);
  }
</style>
