---
/**
 * Section 08 — How it works (approved reference design).
 * Centred heading, a five-step timeline (numbered markers joined by a curved
 * connector with arrows), one SVG vignette, title, description and outcome
 * panel per step, and a centred CTA to the Section 03 form.
 */
import { howItWorks as h } from '../../content/site';
import Icon from '../ui/Icon.astro';
import ProcessArt from '../illustrations/ProcessArt.astro';

const num = (i: number) => String(i + 1).padStart(2, '0');
---
<section class="how" id="how-it-works" aria-labelledby="how-title">
  <div class="how__inner">
    <header class="how__head">
      <p class="how__eyebrow">
        <span class="how__rule" aria-hidden="true"></span>
        <span>{h.number}</span><span>/</span><span>{h.eyebrow}</span>
        <span class="how__rule" aria-hidden="true"></span>
      </p>
      <h2 id="how-title" class="how__title">
        <span class="how__line">{h.title.line}</span>{' '}
        <span class="how__line how__accent">{h.title.accent}</span>
      </h2>
      <p class="how__lede">{h.lede}</p>
    </header>

    <ol class="how__steps" role="list">
      {h.steps.map((s, i) => (
        <li class="how__step">
          <div class="how__marker">
            <span class="how__num" aria-hidden="true">{num(i)}</span>
            {i < h.steps.length - 1 && (
              <svg class="how__link" viewBox="0 0 200 40" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <path d="M0 6C40 4 70 30 100 32S160 14 200 18" fill="none" stroke="#9b5a3e" stroke-width="1.4" vector-effect="non-scaling-stroke" />
              </svg>
            )}
            {i < h.steps.length - 1 && (
              <svg class="how__arrow" viewBox="0 0 12 14" aria-hidden="true" focusable="false"><path d="M2 2l9 7-9 7" fill="none" stroke="#9b5a3e" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
            )}
          </div>
          <div class="how__art"><ProcessArt kind={s.art} /></div>
          <h3 class="how__name"><span class="visually-hidden">Step {i + 1}: </span>{s.title[0]}{' '}<br />{s.title[1]}</h3>
          <p class="how__text">{s.text}</p>
          <div class="how__outcome">
            <Icon name={s.icon} size={34} strokeWidth={1.7} />
            <p><strong>Outcome:</strong> <span>{s.outcome}</span></p>
          </div>
        </li>
      ))}
    </ol>

    <a class="how__cta" href={h.cta.href} data-cta="audit" data-cta-source={h.cta.source} data-cta-label={h.cta.label} data-prefill-requirement={h.cta.requirement}>
      {h.cta.label}<Icon name="arrow" size={22} />
    </a>
  </div>
</section>

<style>
  .how {
    --how-gap: clamp(28px, 4.2vw, 70px);
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, #f5eee4 0, #f2ebe2 140px);
    color: var(--onyx);
  }
  .how__inner {
    max-width: 1672px;
    margin-inline: auto;
    padding: 40px clamp(16px, 5vw, 84px) 30px;
  }

  /* ---------- Heading ---------- */
  .how__head {
    text-align: center;
  }
  .how__eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #2a5a51;
  }
  .how__rule {
    width: clamp(48px, 9.4vw, 156px);
    height: 1px;
    margin-inline: 26px;
    background: rgba(42, 90, 81, 0.6);
  }
  .how__title {
    margin-top: 22px;
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 1.4rem + 3.05vw, 4.7rem);
    font-weight: 500;
    font-variation-settings: 'opsz' 72;
    line-height: 0.98;
    letter-spacing: -0.02em;
    color: #111212;
  }
  .how__line {
    display: block;
  }
  .how__accent {
    color: #9b5a3e;
  }
  .how__lede {
    max-width: 800px;
    margin: 18px auto 0;
    font-size: clamp(1.0625rem, 0.95rem + 0.3vw, 1.27rem);
    line-height: 1.38;
    color: #5f5d58;
  }

  /* ---------- Steps ---------- */
  .how__steps {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    column-gap: var(--how-gap);
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }
  .how__step {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .how__marker {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
    height: 56px;
  }
  .how__num {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #173c36;
    color: #fff;
    font-size: 1.3rem;
    font-weight: 500;
    font-feature-settings: 'tnum';
  }
  /* connector spans from this marker to the next one */
  .how__link {
    position: absolute;
    left: calc(50% + 36px);
    top: 0;
    width: calc(100% + var(--how-gap) - 72px);
    height: 40px;
    overflow: visible;
  }
  .how__arrow {
    position: absolute;
    left: calc(100% + var(--how-gap) / 2 - 8px);
    top: 22px;
    width: 16px;
    height: 18px;
  }
  .how__art {
    margin-top: -24px;
    aspect-ratio: 248 / 160;
    overflow: hidden;
    border-radius: 120px 120px 0 0 / 70px 70px 0 0;
  }
  .how__art :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .how__name {
    margin-top: 18px;
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 1rem + 0.75vw, 1.82rem);
    font-weight: 450;
    line-height: 1.16;
    letter-spacing: -0.01em;
  }
  .how__text {
    flex: 1;
    margin-top: 10px;
    font-size: 1.0625rem;
    line-height: 1.3;
    color: #66645f;
  }
  .how__outcome {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 14px;
    padding: 12px 16px 12px 18px;
    border-radius: 8px;
    background: #ebe4d9;
    color: #173c36;
  }
  .how__outcome :global(svg) {
    flex: none;
  }
  .how__outcome p {
    font-size: 0.875rem;
    line-height: 1.3;
    color: #5f5d58;
  }
  .how__outcome strong {
    display: block;
    font-weight: 600;
    color: #111212;
  }
  .how__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    width: min(392px, 100%);
    min-height: 60px;
    margin: 28px auto 0;
    border-radius: 8px;
    background: #173c36;
    color: #fff;
    font-size: 1.22rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.2s var(--ease);
  }
  .how__cta:hover {
    background: #0f2a25;
  }
  .how__cta :global(svg) {
    transition: transform 0.2s var(--ease);
  }
  .how__cta:hover :global(svg) {
    transform: translateX(3px);
  }
  .how :focus-visible {
    outline: 2px solid #9b6558;
    outline-offset: 3px;
  }

  /* ---------- Tablet: 3 + 2, connector hidden ---------- */
  @media (max-width: 1180px) {
    .how__steps {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      row-gap: 48px;
      column-gap: 32px;
    }
    .how__step {
      grid-column: span 2;
    }
    .how__step:nth-child(4) {
      grid-column: 2 / span 2;
    }
    .how__link,
    .how__arrow {
      display: none;
    }
  }

  /* ---------- Mobile: vertical timeline ---------- */
  @media (max-width: 700px) {
    .how__rule {
      margin-inline: 8px;
    }
    .how__eyebrow {
      font-size: 0.8125rem;
      gap: 8px;
    }
    .how__steps {
      display: block;
      margin-top: 32px;
    }
    .how__step {
      padding: 0 0 36px 72px;
    }
    .how__step:not(:last-child)::before {
      content: '';
      position: absolute;
      left: 23px;
      top: 48px;
      bottom: 0;
      width: 1px;
      background: rgba(155, 90, 62, 0.55);
    }
    .how__marker {
      position: absolute;
      left: 0;
      top: 0;
      height: auto;
    }
    .how__num {
      width: 48px;
      height: 48px;
      font-size: 1.05rem;
    }
    .how__art {
      margin-top: 0;
    }
    .how__name br {
      display: none;
    }
    .how__name {
      margin-top: 16px;
    }
    .how__cta {
      width: 100%;
      margin-top: 8px;
    }
  }
</style>
