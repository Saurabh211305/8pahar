---
import { intelligence } from '../../content/site';
import CtaLink from '../ui/CtaLink.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Picture from '../ui/Picture.astro';
---
<section class="section surface-green on-dark intel" id="intelligent-surveillance" aria-labelledby="intel-title">
  <div class="container">
    <SectionHeading id="intel-title" eyebrow={intelligence.eyebrow} title={intelligence.title} lede={intelligence.lede} class="intel__heading" />

    <div class="intel__grid">
      <figure class="intel__visual">
        <div class="frame intel__frame">
          <Picture name="monitoring-room" alt={intelligence.imageAlt} sizes="(min-width: 1024px) 52vw, 100vw" />
        </div>
        <!-- Glass panel: explains how the parts connect, over the operating environment it describes. -->
        <figcaption class="intel__flow">
          <p class="intel__flow-label">How the parts work together</p>
          <ol role="list" class="intel__flow-list">
            {intelligence.flow.map((step, i) => (
              <li>
                <span class="intel__flow-num" aria-hidden="true">{i + 1}</span>
                <span class="intel__flow-name">{step.name}</span>
                <span class="intel__flow-text">{step.text}</span>
              </li>
            ))}
          </ol>
        </figcaption>
      </figure>

      <div class="intel__content">
        <dl class="intel__caps">
          {intelligence.capabilities.map((cap) => (
            <div class="intel__cap">
              <dt>{cap.name}</dt>
              <dd>{cap.value}</dd>
            </div>
          ))}
        </dl>
        <p class="note intel__caveat">{intelligence.caveat}</p>
        <div class="cta-row">
          <CtaLink cta={intelligence.primary} />
          <CtaLink cta={intelligence.secondary} variant="secondary" />
        </div>
        <CtaLink cta={intelligence.link} variant="link" />
      </div>
    </div>
  </div>
</section>

<style>
  .intel :global(.intel__heading) {
    margin-bottom: clamp(40px, 5vw, 64px);
  }
  .intel__grid {
    display: grid;
    gap: clamp(40px, 5vw, 72px);
  }
  @media (min-width: 1024px) {
    .intel__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: start;
    }
    .intel__visual {
      position: sticky;
      top: calc(var(--header-h) + 24px);
    }
  }
  .intel__visual {
    position: relative;
  }
  .intel__frame {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    background: var(--green-deep);
  }
  .intel__flow {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 16px;
    padding: 16px 18px;
    border-radius: var(--radius-lg);
    background: rgba(15, 42, 37, 0.72);
    border: 1px solid rgba(244, 239, 231, 0.18);
    backdrop-filter: blur(16px) saturate(120%);
    -webkit-backdrop-filter: blur(16px) saturate(120%);
  }
  .intel__flow-label {
    margin-bottom: 12px;
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--terracotta-light);
  }
  .intel__flow-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    counter-reset: flow;
  }
  .intel__flow-list li {
    position: relative;
    display: grid;
    gap: 2px;
    align-content: start;
    padding-right: 10px;
  }
  .intel__flow-list li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 11px;
    left: 30px;
    right: 4px;
    height: 1px;
    background: linear-gradient(90deg, rgba(244, 239, 231, 0.5) 50%, transparent 0) 0 0 / 6px 1px repeat-x;
  }
  .intel__flow-num {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    margin-bottom: 6px;
    border-radius: 50%;
    border: 1px solid rgba(244, 239, 231, 0.6);
    font-size: 0.6875rem;
    font-weight: 700;
  }
  .intel__flow-name {
    font-size: var(--fs-small);
    font-weight: 700;
  }
  .intel__flow-text {
    font-size: var(--fs-xs);
    line-height: 1.4;
    color: var(--on-dark-muted);
  }
  @media (max-width: 599px) {
    .intel__flow {
      position: relative;
      inset: auto;
      margin: -32px 10px 0;
    }
    .intel__flow-list {
      grid-template-columns: 1fr 1fr;
      row-gap: 14px;
    }
    .intel__flow-list li::after {
      display: none;
    }
  }
  .intel__content {
    display: grid;
    gap: 28px;
    justify-items: start;
  }
  .intel__caps {
    display: grid;
    width: 100%;
    border-top: 1px solid var(--line-dark);
  }
  .intel__cap {
    display: grid;
    gap: 4px;
    padding-block: 18px;
    border-bottom: 1px solid var(--line-dark);
  }
  @media (min-width: 640px) {
    .intel__cap {
      grid-template-columns: minmax(180px, 0.8fr) 1.4fr;
      gap: 24px;
    }
  }
  .intel__cap dt {
    font-weight: 700;
    line-height: 1.4;
  }
  .intel__cap dd {
    color: var(--on-dark-muted);
    font-size: var(--fs-small);
    line-height: 1.6;
  }
  .intel__caveat {
    padding-left: 16px;
    border-left: 2px solid var(--terracotta);
  }
</style>
