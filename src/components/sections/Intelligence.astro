---
/**
 * Section 07 — Intelligent surveillance (approved reference design).
 * Left: copy, three capability rows and the CTA. Right: the supplied
 * illustration (unaltered) with the reference's example event cards as HTML,
 * pinned in illustration coordinates. The cards are illustrative only.
 */
import { intelligence as s } from '../../content/site';
import { images } from '../../content/images';
import Icon from '../ui/Icon.astro';

const art = images.surveillance;
const srcset = art.widths.map((w) => `/images/${art.name}-${w}.webp ${w}w`).join(', ');
const num = (i: number) => String(i + 1).padStart(2, '0');
const pos = (a: readonly number[]) => `left:${a[0]}%;top:${a[1]}%;width:${a[2]}%`;
---
<section class="intel" id="intelligent-surveillance" aria-labelledby="intel-title">
  <div class="intel__stage">
    <figure class="intel__art">
      <img src={`/images/${art.name}-1400.webp`} srcset={srcset} sizes="(min-width: 1181px) 83vw, 130vw" alt={s.imageAlt} width={art.width} height={art.height} loading="lazy" decoding="async" />
      <div class="intel__events" aria-hidden="true">
        <div class="intel__chip" style={pos(s.chip.at)}>
          <span class="intel__chip-icon"><Icon name={s.chip.icon} size={22} strokeWidth={1.6} /></span>
          <span><strong>{s.chip.title}</strong><span>{s.chip.meta}</span></span>
        </div>
        {s.events.map((e) => (
          <div class:list={['intel__event', e.active && 'intel__event--active']} style={pos(e.at)}>
            <span class="intel__event-icon"><Icon name={e.icon} size={20} strokeWidth={1.6} /></span>
            <img src={`/images/${e.thumb}.webp`} alt="" width="74" height="86" loading="lazy" decoding="async" />
            <span class="intel__event-text"><strong>{e.title}</strong><span>{e.place}</span><span>{e.time}</span></span>
          </div>
        ))}
      </div>
      <figcaption class="visually-hidden">Illustration with example detection notifications; not a live camera feed.</figcaption>
    </figure>

    <div class="intel__copy">
      <p class="intel__eyebrow">
        <span>{s.number}</span><span>/</span><span>{s.eyebrow}</span>
        <span class="intel__rule" aria-hidden="true"></span>
      </p>
      <h2 id="intel-title" class="intel__title">
        <span class="intel__line">{s.title.line}</span>{' '}
        <span class="intel__line intel__accent">{s.title.accent}</span>
      </h2>
      <p class="intel__lede">{s.lede}</p>

      <ol class="intel__caps" role="list">
        {s.capabilities.map((c, i) => (
          <li class="intel__cap">
            <span class="intel__cap-icon" aria-hidden="true"><Icon name={c.icon} size={32} strokeWidth={1.5} /></span>
            <div class="intel__cap-body">
              <h3 class="intel__cap-title"><span class="intel__cap-num">{num(i)}.</span> {c.title}</h3>
              <p class="intel__cap-text">{c.text}</p>
            </div>
          </li>
        ))}
      </ol>

      <a class="intel__cta" href={s.cta.href} data-cta="audit" data-cta-source={s.cta.source} data-cta-label={s.cta.label} data-prefill-requirement={s.cta.requirement}>
        {s.cta.label}<Icon name="arrow" size={22} />
      </a>
    </div>
  </div>
</section>

<style>
  .intel {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, #f6f1ea 0, #f5eee4 140px);
    color: var(--onyx);
  }
  /* Desktop stage keeps the reference's 1672 × 941 proportions; 1cqi = 1% of its width. */
  .intel__stage {
    position: relative;
    max-width: 1920px;
    margin-inline: auto;
    aspect-ratio: 1672 / 941;
    container-type: inline-size;
  }

  /* ---------- Illustration ---------- */
  .intel__art {
    position: absolute;
    z-index: 0;
    left: 16.9%;
    top: 0.6%;
    width: 82.7%;
    margin: 0;
    container-type: inline-size;
  }
  .intel__art > img {
    display: block;
    width: 100%;
    height: auto;
    /* the artwork's left third sits back behind the copy; soft foot */
    -webkit-mask-image: linear-gradient(90deg, transparent 0, transparent 29%, #000 41%), linear-gradient(0deg, transparent 0, #000 6%);
    -webkit-mask-composite: source-in, source-over;
    mask-image: linear-gradient(90deg, transparent 0, transparent 29%, #000 41%), linear-gradient(0deg, transparent 0, #000 6%);
    mask-composite: intersect, add;
  }
  .intel__events {
    position: absolute;
    inset: 0;
  }
  .intel__chip,
  .intel__event {
    position: absolute;
    display: flex;
    align-items: center;
    border-radius: 0.55cqi;
    background: rgba(255, 253, 249, 0.96);
    box-shadow: 0 0.6cqi 1.8cqi -0.8cqi rgba(17, 18, 18, 0.4);
    color: var(--onyx);
    line-height: 1.3;
  }
  .intel__chip {
    gap: 1.1cqi;
    padding: 0.85cqi 1.1cqi;
    font-size: max(10px, 1cqi);
    white-space: nowrap;
  }
  .intel__chip strong,
  .intel__event strong {
    display: block;
    font-weight: 600;
  }
  .intel__chip span span,
  .intel__event-text span {
    display: block;
    color: #4a4c4a;
  }
  .intel__chip-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.3cqi;
    height: 3.3cqi;
    border-radius: 50%;
    background: #173c36;
    color: #fff;
  }
  .intel__event {
    gap: 0.8cqi;
    padding: 0.7cqi 0.8cqi 0.7cqi 1cqi;
    font-size: max(9px, 0.92cqi);
    white-space: nowrap;
    letter-spacing: -0.01em;
  }
  .intel__event--active {
    outline: 2px solid #4caf74;
    outline-offset: -1px;
  }
  .intel__event-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 3cqi;
    height: 3cqi;
    border: 1px solid rgba(17, 18, 18, 0.18);
    border-radius: 50%;
    color: #173c36;
  }
  .intel__event-icon :global(svg),
  .intel__chip-icon :global(svg) {
    width: 55%;
    height: 55%;
  }
  .intel__event img {
    flex: none;
    width: 5.6cqi;
    height: auto;
    border-radius: 0.3cqi;
  }
  .intel__event-text span {
    margin-top: 0.4cqi;
    font-size: 0.9em;
  }
  .intel__event-text span + span {
    margin-top: 0.15cqi;
  }

  /* ---------- Copy ---------- */
  .intel__copy {
    position: absolute;
    z-index: 2;
    left: 5.8cqi;
    top: 5.2cqi;
    width: 37cqi;
  }
  .intel__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75cqi;
    font-size: max(11px, 0.95cqi);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #173c36;
  }
  .intel__rule {
    width: 16cqi;
    height: 1px;
    margin-left: 2cqi;
    background: rgba(23, 60, 54, 0.6);
  }
  .intel__title {
    margin-top: 2.4cqi;
    font-family: var(--font-serif);
    font-size: max(34px, 4.6cqi);
    font-weight: 500;
    font-variation-settings: 'opsz' 72;
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: #111212;
    text-wrap: initial;
  }
  .intel__line {
    display: block;
    white-space: nowrap;
  }
  .intel__accent {
    color: #9b5a3e;
  }
  .intel__lede {
    max-width: 35cqi;
    margin-top: 1.3cqi;
    font-size: max(15px, 1.16cqi);
    line-height: 1.45;
    letter-spacing: 0.005em;
    color: #3a3d3b;
  }
  .intel__caps {
    margin: 1.7cqi 0 0;
    padding: 0;
    list-style: none;
  }
  .intel__cap {
    display: grid;
    grid-template-columns: 4.6cqi 1fr;
    column-gap: 3.6cqi;
    align-items: center;
    padding-block: 1.05cqi;
    position: relative;
  }
  .intel__cap + .intel__cap::before {
    content: '';
    position: absolute;
    top: 0;
    left: 8.2cqi;
    right: 0;
    height: 1px;
    background: rgba(17, 18, 18, 0.12);
  }
  .intel__cap-icon {
    display: grid;
    place-items: center;
    width: 4.6cqi;
    height: 4.6cqi;
    border-radius: 50%;
    background: #e5e4d7;
    color: #173c36;
    position: relative;
  }
  .intel__cap-icon::after {
    content: '';
    position: absolute;
    right: -1.6cqi;
    top: 18%;
    bottom: 18%;
    width: 1px;
    background: rgba(17, 18, 18, 0.14);
  }
  .intel__cap-icon :global(svg) {
    width: 52%;
    height: 52%;
  }
  .intel__cap-title {
    font-family: var(--font-serif);
    font-size: max(18px, 1.5cqi);
    font-weight: 500;
    line-height: 1.2;
  }
  .intel__cap-num {
    color: #9b5a3e;
  }
  .intel__cap-text {
    margin-top: 0.45cqi;
    max-width: 25.5cqi;
    font-size: max(13px, 1.0cqi);
    line-height: 1.42;
    color: #4a4c4a;
  }
  .intel__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1.9cqi;
    width: 24.6cqi;
    min-width: 260px;
    min-height: max(52px, 3.75cqi);
    margin-top: 1.8cqi;
    border-radius: 6px;
    background: #173c36;
    color: #fff;
    font-size: max(16px, 1.27cqi);
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.2s var(--ease);
  }
  .intel__cta:hover {
    background: #0f2a25;
  }
  .intel__cta :global(svg) {
    flex: none;
    transition: transform 0.2s var(--ease);
  }
  .intel__cta:hover :global(svg) {
    transform: translateX(3px);
  }
  .intel :focus-visible {
    outline: 2px solid #9b6558;
    outline-offset: 3px;
  }

  /* ---------- Laptop / tablet / mobile: copy, then the illustration ---------- */
  @media (max-width: 1180px) {
    .intel__stage {
      aspect-ratio: auto;
      display: flex;
      flex-direction: column;
      padding: 56px 0 40px;
    }
    .intel__copy {
      position: static;
      transform: none;
      margin: 0;
      width: auto;
      max-width: 720px;
      padding-inline: var(--gutter);
    }
    .intel__eyebrow {
      font-size: 0.8125rem;
      gap: 10px;
    }
    .intel__rule {
      flex: 1;
      max-width: 200px;
      margin-left: 16px;
    }
    .intel__title {
      margin-top: 22px;
      font-size: clamp(2.4rem, 1.6rem + 3vw, 4rem);
    }
    .intel__lede {
      max-width: none;
      margin-top: 16px;
      font-size: 1.0625rem;
    }
    .intel__caps {
      margin-top: 24px;
    }
    .intel__cap {
      grid-template-columns: 60px 1fr;
      column-gap: 36px;
      padding-block: 16px;
    }
    .intel__cap + .intel__cap::before {
      left: 96px;
    }
    .intel__cap-icon {
      width: 60px;
      height: 60px;
    }
    .intel__cap-icon::after {
      right: -18px;
    }
    .intel__cap-title {
      font-size: 1.25rem;
    }
    .intel__cap-text {
      max-width: none;
      margin-top: 6px;
      font-size: 0.95rem;
    }
    .intel__cta {
      width: fit-content;
      padding-inline: 32px;
      margin-top: 24px;
      gap: 18px;
    }
    .intel__art {
      position: relative;
      order: 2;
      left: auto;
      top: auto;
      width: 140%;
      margin: 24px 0 0 -40%;
    }
  }
  @media (max-width: 700px) {
    .intel__line {
      white-space: normal;
    }
    .intel__cta {
      width: 100%;
    }
    .intel__cap {
      grid-template-columns: 48px 1fr;
      column-gap: 20px;
      align-items: start;
    }
    .intel__cap + .intel__cap::before {
      left: 68px;
    }
    .intel__cap-icon {
      width: 48px;
      height: 48px;
    }
    .intel__cap-icon::after {
      display: none;
    }
    /* event cards would be too small to read here */
    .intel__events {
      display: none;
    }
  }
</style>
