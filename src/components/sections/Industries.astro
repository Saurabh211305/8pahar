---
import { industries } from '../../content/site';
import type { ImageName } from '../../content/images';
import CtaLink from '../ui/CtaLink.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Picture from '../ui/Picture.astro';

const sizes: Record<string, string> = {
  residential: '(min-width: 1024px) 56vw, 100vw',
  commercial: '(min-width: 1024px) 40vw, (min-width: 700px) 50vw, 100vw',
  industrial: '(min-width: 1024px) 40vw, (min-width: 700px) 50vw, 100vw',
  construction: '(min-width: 1024px) 46vw, 100vw',
};
---
<section class="section surface-white industries" id="industries" aria-labelledby="industries-title">
  <div class="container">
    <div class="industries__head">
      <SectionHeading id="industries-title" eyebrow={industries.eyebrow} title={industries.title} />
      <p class="lede">{industries.lede}</p>
    </div>

    <div class="industries__mosaic">
      {industries.items.map((item) => (
        <article class:list={['industry', `industry--${item.id}`]} id={`industry-${item.id}`} aria-labelledby={`industry-${item.id}-title`}>
          <div class="frame industry__frame">
            <Picture name={item.image as ImageName} alt={item.imageAlt} sizes={sizes[item.id]} />
            <span class="industry__label">{item.label}</span>
          </div>
          <div class="industry__body">
            <h3 class="industry__title" id={`industry-${item.id}-title`}>{item.title}</h3>
            <p class="industry__text">{item.text}</p>
            <ul role="list" class="industry__needs" aria-label={`Typical ${item.label.toLowerCase()} requirements`}>
              {item.needs.map((need) => <li>{need}</li>)}
            </ul>
            <CtaLink cta={item.cta} variant={item.id === 'residential' ? 'primary' : 'secondary'} />
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .industries__head {
    display: grid;
    gap: 24px;
    align-items: end;
    margin-bottom: clamp(40px, 5vw, 64px);
  }
  @media (min-width: 960px) {
    .industries__head {
      grid-template-columns: 1.3fr 1fr;
      gap: 64px;
    }
  }
  .industries__mosaic {
    display: grid;
    gap: clamp(32px, 3vw, 40px);
  }
  @media (min-width: 700px) {
    .industries__mosaic {
      grid-template-columns: 1fr 1fr;
    }
    .industry--residential,
    .industry--construction {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1024px) {
    .industries__mosaic {
      grid-template-columns: repeat(12, 1fr);
      column-gap: clamp(24px, 3vw, 48px);
      row-gap: 56px;
    }
    .industry--residential {
      grid-column: 1 / span 7;
      grid-row: 1 / span 2;
    }
    .industry--commercial {
      grid-column: 8 / span 5;
    }
    .industry--industrial {
      grid-column: 8 / span 5;
    }
    .industry--construction {
      grid-column: 1 / -1;
      grid-template-columns: 1.15fr 1fr;
      align-items: center;
      gap: clamp(32px, 4vw, 64px);
      padding-top: 56px;
      border-top: 1px solid var(--line);
    }
  }
  .industry {
    display: grid;
    gap: 22px;
    align-content: start;
  }
  .industry__frame {
    border-radius: var(--radius-lg);
    aspect-ratio: 3 / 2;
  }
  .industry--residential .industry__frame {
    aspect-ratio: 4 / 3;
  }
  @media (min-width: 1024px) {
    .industry--residential .industry__frame {
      aspect-ratio: 4 / 5;
    }
    .industry--commercial .industry__frame,
    .industry--industrial .industry__frame {
      aspect-ratio: 16 / 9;
    }
    .industry--construction .industry__frame {
      aspect-ratio: 16 / 9;
    }
  }
  .industry__label {
    position: absolute;
    top: 16px;
    left: 16px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(17, 18, 18, 0.72);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: var(--ivory);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .industry__body {
    display: grid;
    gap: 12px;
    justify-items: start;
  }
  .industry__title {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 1.2rem + 0.7vw, 1.75rem);
    font-weight: 450;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .industry--residential .industry__title {
    font-size: clamp(1.6rem, 1.3rem + 1vw, 2.15rem);
  }
  .industry__text {
    color: var(--ink-muted);
    font-size: var(--fs-small);
  }
  .industry__needs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-block: 4px 8px;
  }
  .industry__needs li {
    padding: 6px 12px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--ink-soft);
    line-height: 1.3;
  }
</style>
