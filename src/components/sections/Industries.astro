---
/**
 * Section 06 — Industries & properties (approved reference design).
 * Left: editorial copy, the supplied property photograph (with its own arcs)
 * fading up from the bottom-left, and the "Discuss Your Property's Security"
 * card. Right: four photo cards in a 2×2 grid. Each card opens the Section 03
 * form with its property type pre-selected.
 */
import { industries as ind } from '../../content/site';
import { images, type ImageName } from '../../content/images';
import Icon from '../ui/Icon.astro';

const bg = images['ind-bg'];
const bgSrcset = bg.widths.map((w) => `/images/${bg.name}-${w}.webp ${w}w`).join(', ');
const num = (i: number) => String(i + 1).padStart(2, '0');
const photo = (name: string) => {
  const img = images[name as ImageName];
  return {
    src: `/images/${img.name}-${img.widths[img.widths.length - 1]}.webp`,
    srcset: img.widths.map((w) => `/images/${img.name}-${w}.webp ${w}w`).join(', '),
    width: img.width,
    height: img.height,
  };
};
---
<section class="ind" id="industries" aria-labelledby="industries-title">
  <div class="ind__inner">
    <div class="ind__left">
      <div class="ind__bg" aria-hidden="true">
        <img src={`/images/${bg.name}-960.webp`} srcset={bgSrcset} sizes="(min-width: 1181px) 70vw, 100vw" alt="" width={bg.width} height={bg.height} loading="lazy" decoding="async" />
      </div>
      <span class="ind__tab" aria-hidden="true"></span>

      <div class="ind__copy">
        <p class="ind__eyebrow">
          <span>{ind.number}</span><span class="ind__slash">/</span><span>{ind.eyebrow}</span>
          <span class="ind__rule" aria-hidden="true"></span>
        </p>
        <h2 id="industries-title" class="ind__title">
          <span class="ind__line">{ind.title.lines[0]}</span>{' '}
          <span class="ind__line">{ind.title.lines[1]} <span class="ind__accent">{ind.title.accent[0]}</span></span>{' '}
          <span class="ind__line ind__accent">{ind.title.accent[1]}</span>
        </h2>
        <p class="ind__lede">{ind.lede}</p>
      </div>

      <a
        class="ind__cta"
        href={ind.cta.href}
        data-cta="audit"
        data-cta-source={ind.cta.source}
        data-cta-label={ind.cta.label}
        aria-label={ind.cta.label}
      >
        <span class="ind__cta-kicker">{ind.cta.kicker}</span>
        <span class="ind__cta-title" aria-hidden="true">{ind.cta.lines.map((l) => <span>{l}</span>)}</span>
        <span class="ind__cta-arrow" aria-hidden="true"><Icon name="arrow" size={24} strokeWidth={1.4} /></span>
        <svg class="ind__cta-arc" viewBox="0 0 200 120" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M0 120C30 60 90 20 200 10" fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" /></svg>
      </a>
    </div>

    <ul class="ind__grid" role="list">
      {ind.items.map((item, i) => {
        const img = photo(item.image);
        return (
          <li class="ind__card" id={`industry-${item.id}`}>
            <div class="ind__media">
              <img src={img.src} srcset={img.srcset} sizes="(min-width: 1181px) 26vw, (min-width: 701px) 50vw, 100vw" alt={item.imageAlt} width={img.width} height={img.height} loading="lazy" decoding="async" />
            </div>
            <div class="ind__body">
              <div class="ind__meta" aria-hidden="true">
                <span class="ind__num">{num(i)}</span>
                <span class="ind__icon"><Icon name={item.icon} size={36} strokeWidth={1.3} /></span>
                <span class="ind__divider"></span>
                <span class="ind__go"><Icon name="chevron" size={16} strokeWidth={1.6} /></span>
              </div>
              <h3 class="ind__name">
                <a
                  class="ind__link"
                  href="#audit"
                  data-cta="audit"
                  data-cta-source="industries-card"
                  data-cta-label={`${item.label} security assessment`}
                  data-prefill-property={item.property}
                >{item.label}</a>
              </h3>
              <p class="ind__sub">{item.title}</p>
              <p class="ind__text">{item.text}</p>
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .ind {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: linear-gradient(180deg, #fcf7ee 0, #f6f1ea 160px);
    color: var(--onyx);
  }
  .ind__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 860px);
    column-gap: 56px;
    max-width: 1720px;
    margin-inline: auto;
    padding: 50px clamp(16px, 2.9vw, 48px) 40px 0;
  }

  /* ---------- Left column ---------- */
  .ind__left {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100%;
  }
  .ind__bg {
    position: absolute;
    z-index: 0;
    left: 0;
    bottom: -40px;
    width: 170%;
    pointer-events: none;
  }
  .ind__bg img {
    display: block;
    width: 100%;
    height: auto;
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 22%);
    mask-image: linear-gradient(180deg, transparent 0, #000 22%);
  }
  .ind__tab {
    position: absolute;
    z-index: 1;
    left: 0;
    top: 37%;
    width: 42px;
    height: 20%;
    border-radius: 0 8px 8px 0;
    background: #173c36;
  }
  .ind__copy {
    position: relative;
    z-index: 2;
    padding-left: clamp(16px, 4.9vw, 82px);
  }
  .ind__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9b6558;
  }
  .ind__rule {
    flex: 1;
    max-width: 196px;
    height: 1px;
    margin-left: 10px;
    background: rgba(155, 101, 88, 0.55);
  }
  .ind__title {
    margin-top: 32px;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 1.6rem + 2.6vw, 4.3rem);
    font-weight: 450;
    font-variation-settings: 'opsz' 72;
    line-height: 0.98;
    letter-spacing: -0.018em;
    color: #111212;
    text-wrap: initial;
  }
  .ind__line {
    display: block;
    white-space: nowrap;
  }
  .ind__accent {
    color: #9b5a3e;
  }
  .ind__lede {
    max-width: 540px;
    margin-top: 26px;
    font-size: 1.17rem;
    line-height: 1.4;
    letter-spacing: 0.01em;
    color: #2a2c2b;
  }

  /* CTA card */
  .ind__cta {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'kicker arrow'
      'title arrow';
    align-items: center;
    gap: 10px 24px;
    max-width: 610px;
    margin: 40px 0 0 clamp(16px, 4.2vw, 69px);
    padding: 34px 42px 30px 46px;
    overflow: hidden;
    border-radius: 8px;
    background: linear-gradient(120deg, #173c36 0%, #102b27 100%);
    color: #f4efe7;
    text-decoration: none;
    box-shadow: 0 24px 40px -28px rgba(17, 18, 18, 0.6);
  }
  .ind__cta-kicker {
    grid-area: kicker;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(244, 239, 231, 0.88);
  }
  .ind__cta-title {
    grid-area: title;
    display: grid;
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 1.3rem + 1vw, 2.35rem);
    font-weight: 430;
    line-height: 1.12;
    letter-spacing: -0.01em;
  }
  .ind__cta-arrow {
    grid-area: arrow;
    display: grid;
    place-items: center;
    width: 66px;
    height: 66px;
    border: 1.3px solid rgba(244, 239, 231, 0.85);
    border-radius: 50%;
    transition: background-color 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .ind__cta:hover .ind__cta-arrow {
    background: rgba(244, 239, 231, 0.12);
    transform: translateX(3px);
  }
  .ind__cta:focus-visible {
    outline: 2px solid #9b6558;
    outline-offset: 4px;
  }
  .ind__cta-arc {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 52%;
    height: 70%;
    color: rgba(244, 239, 231, 0.18);
    pointer-events: none;
  }

  /* ---------- Cards ---------- */
  .ind__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ind__card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgba(17, 18, 18, 0.09);
    border-radius: 6px;
    background: #f5f0e8;
    box-shadow: 0 10px 24px -22px rgba(17, 18, 18, 0.4);
    scroll-margin-top: calc(var(--header-h) + 24px);
    transition: box-shadow 0.25s var(--ease), border-color 0.25s var(--ease);
  }
  .ind__card:hover {
    border-color: rgba(155, 101, 88, 0.45);
    box-shadow: 0 18px 34px -24px rgba(17, 18, 18, 0.5);
  }
  .ind__card:focus-within {
    box-shadow: 0 0 0 2px #9b6558;
  }
  .ind__card:target {
    box-shadow: 0 0 0 2px #9b6558;
  }
  .ind__media {
    aspect-ratio: 380 / 241;
    overflow: hidden;
    background: var(--sand);
  }
  .ind__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .ind__card:hover .ind__media img {
    transform: scale(1.03);
  }
  .ind__body {
    padding: 18px 22px 24px;
  }
  .ind__meta {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .ind__num {
    padding-right: 18px;
    border-right: 1px solid rgba(17, 18, 18, 0.14);
    font-family: var(--font-serif);
    font-size: 2.6rem;
    font-weight: 400;
    line-height: 1;
    color: #9b5a3e;
    font-feature-settings: 'lnum';
  }
  .ind__icon {
    display: grid;
    color: #2a2c2b;
  }
  .ind__divider {
    flex: 1;
    max-width: 140px;
    height: 1px;
    margin-left: auto;
    background: rgba(155, 101, 88, 0.45);
  }
  .ind__go {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin-left: 26px;
    border: 1px solid rgba(155, 101, 88, 0.7);
    border-radius: 50%;
    color: #111212;
    transform: rotate(-90deg);
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .ind__card:hover .ind__go {
    background: #173c36;
    border-color: #173c36;
    color: #fff;
  }
  .ind__name {
    margin-top: 22px;
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 1.2rem + 0.75vw, 2rem);
    font-weight: 450;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  .ind__link {
    color: inherit;
    text-decoration: none;
  }
  /* whole card is the click target */
  .ind__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .ind__link:focus-visible {
    outline: none;
  }
  .ind__sub {
    margin-top: 10px;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #3a3d3b;
  }
  .ind__text {
    margin-top: 14px;
    font-size: 0.97rem;
    line-height: 1.45;
    color: #2f3231;
  }

  /* ---------- Laptop / tablet: copy and cards stacked ---------- */
  @media (max-width: 1440px) {
    .ind__inner {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
      column-gap: 40px;
    }
    .ind__cta {
      padding: 28px 30px;
    }
    .ind__cta-arrow {
      width: 56px;
      height: 56px;
    }
  }
  @media (max-width: 1180px) {
    .ind__inner {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 32px;
      padding: 56px var(--gutter) 48px;
    }
    .ind__copy {
      padding-left: 0;
    }
    .ind__tab {
      display: none;
    }
    .ind__bg {
      left: calc(-1 * var(--gutter));
      bottom: 0;
      width: calc(100% + 2 * var(--gutter));
    }
    .ind__cta {
      order: 0;
      margin: 32px 0 0;
      max-width: 640px;
    }
    .ind__left {
      padding-bottom: clamp(160px, 34vw, 380px);
    }
    .ind__left::after {
      content: none;
    }
  }
  @media (max-width: 700px) {
    .ind__line {
      white-space: normal;
    }
    .ind__grid {
      grid-template-columns: 1fr;
    }
    .ind__cta {
      grid-template-columns: 1fr;
      grid-template-areas: 'kicker' 'title' 'arrow';
      padding: 26px 24px;
    }
    .ind__cta-arrow {
      width: 48px;
      height: 48px;
    }
    .ind__left {
      padding-bottom: 170px;
    }
    .ind__bg {
      width: 180%;
    }
  }
</style>
