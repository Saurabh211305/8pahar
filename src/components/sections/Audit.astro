---
import { audit } from '../../content/site';
import { business } from '../../config/business';
import CtaLink from '../ui/CtaLink.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import EnquiryForm from '../ui/EnquiryForm.astro';
import Icon from '../ui/Icon.astro';

const pricing = business.auditPricing;
const pricingText =
  pricing?.type === 'free'
    ? 'The initial security audit is free of charge.'
    : pricing?.type === 'paid'
      ? pricing.note
      : 'Any assessment fee and its scope are confirmed with you before the audit is booked.';
---
<section class="section surface-sand audit" id="audit" aria-labelledby="audit-title">
  <div class="container audit__grid">
    <SectionHeading id="audit-title" eyebrow={audit.eyebrow} title={audit.title} lede={audit.lede} class="audit__heading" />

    <div class="audit__content">

      <div class="audit__block">
        <h3 class="audit__subhead">{audit.coverTitle}</h3>
        <ol role="list" class="audit__checklist">
          {audit.cover.map((item, i) => (
            <li>
              <span class="audit__index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span>{item}</span>
            </li>
          ))}
        </ol>
        <p class="note audit__scope">{audit.scopeNote}</p>
      </div>

      <div class="audit__block">
        <h3 class="audit__subhead">{audit.receiveTitle}</h3>
        <ul role="list" class="audit__receive">
          {audit.receive.map((item) => (
            <li><Icon name="check" size={18} class="audit__tick" />{item}</li>
          ))}
        </ul>
      </div>
    </div>

    <div class="audit__aside">
      <div class="audit__sticky">
        <EnquiryForm id="audit" title={audit.formTitle} intro={audit.formIntro} submitLabel={audit.submit} defaultRequirement="security-audit" />
        <p class="audit__pricing">{pricingText}</p>
        <CtaLink cta={audit.secondary} variant="link" />
      </div>
    </div>
  </div>
</section>

<style>
  .audit__grid {
    display: grid;
    gap: clamp(36px, 4vw, 56px);
    grid-template-areas: 'heading' 'form' 'content';
  }
  .audit__grid > :global(.audit__heading) {
    grid-area: heading;
  }
  .audit__content {
    grid-area: content;
  }
  .audit__aside {
    grid-area: form;
  }
  @media (min-width: 1024px) {
    .audit__grid {
      grid-template-columns: minmax(0, 1fr) minmax(400px, 0.9fr);
      grid-template-rows: auto 1fr;
      grid-template-areas: 'heading form' 'content form';
      column-gap: clamp(48px, 6vw, 96px);
      align-items: start;
    }
  }
  .audit__content {
    display: grid;
    gap: clamp(32px, 4vw, 48px);
  }
  .audit__subhead {
    margin-bottom: 18px;
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--green);
  }
  .audit__checklist {
    display: grid;
    border-top: 1px solid var(--line-strong);
  }
  @media (min-width: 640px) {
    .audit__checklist {
      grid-template-columns: 1fr 1fr;
      column-gap: 32px;
    }
  }
  .audit__checklist li {
    display: flex;
    gap: 16px;
    align-items: baseline;
    padding-block: 14px;
    border-bottom: 1px solid var(--line);
    font-weight: 550;
  }
  .audit__index {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    color: var(--terracotta-ink);
    font-feature-settings: 'lnum';
  }
  .audit__scope {
    margin-top: 14px;
  }
  .audit__receive {
    display: grid;
    gap: 10px;
  }
  .audit__receive li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    color: var(--ink-soft);
  }
  .audit__receive :global(.audit__tick) {
    flex: none;
    margin-top: 4px;
    color: var(--green);
  }
  .audit__sticky {
    display: grid;
    gap: 14px;
    justify-items: start;
  }
  .audit__sticky > :global(.lead) {
    width: 100%;
  }
  @media (min-width: 1024px) {
    .audit__sticky {
      position: sticky;
      top: calc(var(--header-h) + 24px);
    }
  }
  .audit__pricing {
    font-size: var(--fs-small);
    color: var(--ink-muted);
  }
</style>
