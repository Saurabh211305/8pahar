---
/**
 * Simplified property plan: three camera fields of view, the path visitors
 * take from the gate, and the blind spot the cameras miss. Illustrative.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<svg class={className} viewBox="0 0 320 220" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="cov-title" focusable="false">
  <title id="cov-title">Illustrative property plan showing three camera fields of view and an uncovered blind spot in one room</title>
  <defs>
    <pattern id="cov-hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="6" stroke="#9B6558" stroke-width="1.6" />
    </pattern>
  </defs>
  <!-- blind spot -->
  <rect x="172" y="28" width="120" height="78" fill="url(#cov-hatch)" opacity="0.55" />
  <rect x="172" y="28" width="120" height="78" fill="none" stroke="#9B6558" stroke-width="1.2" stroke-dasharray="4 3" />
  <!-- fields of view -->
  <g fill="#173C36" fill-opacity="0.16" stroke="#173C36" stroke-opacity="0.7" stroke-width="1">
    <path d="M30 192 L30 108 A84 84 0 0 1 114 192 Z" />
    <path d="M292 192 L206 192 A86 86 0 0 1 292 106 Z" />
    <path d="M28 28 L132 28 A104 104 0 0 1 101.5 101.5 Z" />
  </g>
  <!-- walls -->
  <g fill="none" stroke="#111212" stroke-width="2.5" stroke-linecap="square">
    <path d="M200 194 H292 V26 H28 V194 H168" />
    <path d="M164 26 V84 M164 112 V120 H28" />
    <path d="M220 120 H292" />
  </g>
  <!-- visitor path from the gate -->
  <path d="M184 214 C184 170 160 150 164 98" fill="none" stroke="#111212" stroke-width="1.2" stroke-dasharray="3 4" />
  <circle cx="184" cy="210" r="3" fill="#111212" />
  <!-- cameras -->
  <g fill="#111212">
    <rect x="25" y="187" width="10" height="10" rx="2" />
    <rect x="287" y="187" width="10" height="10" rx="2" />
    <rect x="23" y="23" width="10" height="10" rx="2" />
  </g>
  <!-- blind spot marker -->
  <circle cx="232" cy="67" r="11" fill="#F4EFE7" stroke="#9B6558" stroke-width="1.5" />
  <path d="M232 61v7M232 71.5v.5" stroke="#9B6558" stroke-width="2" stroke-linecap="round" />
  <text x="184" y="214" dx="10" dy="2" font-size="10" font-weight="700" letter-spacing="0.12em" fill="#111212" font-family="Manrope Variable, system-ui, sans-serif">GATE</text>
</svg>
