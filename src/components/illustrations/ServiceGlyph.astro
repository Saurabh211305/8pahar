---
/** Line glyphs for the eight service categories (64px grid, 1.5px line, green accent). */
interface Props {
  kind: string;
  class?: string;
}
const { kind, class: className } = Astro.props;
---
<svg class={className} viewBox="0 0 64 64" width="56" height="56" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" fill="none" stroke="#111212" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
  {kind === 'camera' && (
    <g>
      <path d="M8 10 V26 M8 18 H16" />
      <path d="M16 12 L44 20 L42 30 L14 22 Z" fill="#173C36" fill-opacity="0.14" />
      <path d="M44 22 L58 18 V40 L40 30" stroke="#173C36" stroke-dasharray="2 3" />
      <circle cx="40" cy="24" r="1.6" fill="#111212" stroke="none" />
    </g>
  )}
  {kind === 'analytics' && (
    <g>
      <path d="M8 16 V8 H16 M48 8 H56 V16 M56 48 V56 H48 M16 56 H8 V48" />
      <rect x="22" y="16" width="20" height="34" stroke="#173C36" stroke-dasharray="3 3" />
      <circle cx="32" cy="24" r="4" fill="#173C36" fill-opacity="0.2" />
      <path d="M26 46 C26 36 38 36 38 46" fill="#173C36" fill-opacity="0.2" />
      <path d="M10 40 H54" stroke="#9B6558" />
    </g>
  )}
  {kind === 'access' && (
    <g>
      <path d="M10 56 V8 H36 V56" />
      <circle cx="31" cy="33" r="1.6" fill="#111212" stroke="none" />
      <rect x="42" y="24" width="12" height="18" rx="2" fill="#173C36" fill-opacity="0.14" />
      <path d="M45 30 h6 M45 35 h6" stroke="#173C36" />
      <path d="M6 56 H58" />
    </g>
  )}
  {kind === 'doorphone' && (
    <g>
      <rect x="16" y="6" width="26" height="52" rx="3" />
      <rect x="20" y="12" width="18" height="16" rx="1.5" fill="#173C36" fill-opacity="0.16" stroke="#173C36" />
      <circle cx="29" cy="20" r="3" stroke="#173C36" />
      <circle cx="29" cy="44" r="4" />
      <path d="M48 18 c4 4 4 12 0 16 M53 14 c6 6 6 18 0 24" stroke="#9B6558" />
    </g>
  )}
  {kind === 'install' && (
    <g>
      <rect x="6" y="10" width="14" height="10" rx="2" fill="#173C36" fill-opacity="0.14" />
      <rect x="44" y="10" width="14" height="10" rx="2" fill="#173C36" fill-opacity="0.14" />
      <rect x="20" y="42" width="24" height="12" rx="2" />
      <path d="M13 20 V30 H32 V42 M51 20 V30 H32" />
      <circle cx="32" cy="30" r="2" fill="#9B6558" stroke="none" />
      <path d="M26 48 h2 M31 48 h2" />
    </g>
  )}
  {kind === 'monitor' && (
    <g>
      <rect x="6" y="10" width="52" height="34" rx="2" />
      <path d="M32 10 V44 M6 27 H58" stroke-opacity="0.5" />
      <rect x="9" y="13" width="20" height="11" fill="#173C36" fill-opacity="0.16" stroke="none" />
      <circle cx="51" cy="18" r="2" fill="#9B6558" stroke="none" />
      <path d="M24 54 H40 M32 44 V54" />
    </g>
  )}
  {kind === 'upgrade' && (
    <g>
      <rect x="6" y="34" width="20" height="20" rx="2" stroke-dasharray="3 3" stroke-opacity="0.6" />
      <rect x="36" y="18" width="22" height="36" rx="2" fill="#173C36" fill-opacity="0.14" />
      <path d="M16 28 C16 16 26 12 34 12 M30 7 L35 12 L30 17" stroke="#173C36" />
    </g>
  )}
  {kind === 'maintain' && (
    <g>
      <path d="M50 22 A20 20 0 0 0 14 22 M14 42 A20 20 0 0 0 50 42" />
      <path d="M44 22 H51 V15 M20 42 H13 V49" />
      <circle cx="32" cy="32" r="9" fill="#173C36" fill-opacity="0.14" stroke="#173C36" />
      <path d="M28 32 l3 3 5 -6" stroke="#173C36" />
    </g>
  )}
</svg>
