---
/** Small interface icons (1.5px line, 24px grid). Decorative unless `label` is set. */
interface Props {
  name: 'arrow' | 'phone' | 'whatsapp' | 'menu' | 'close' | 'plus' | 'check' | 'mail' | 'alert';
  size?: number;
  label?: string;
  class?: string;
}
const { name, size = 18, label, class: className } = Astro.props;
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {name === 'arrow' && <path d="M4 12h15M13.5 6.5 19 12l-5.5 5.5" />}
  {name === 'phone' && <path d="M5.2 3.5h3.2l1.6 4.3-2.1 1.4a11.6 11.6 0 0 0 6.9 6.9l1.4-2.1 4.3 1.6v3.2a2 2 0 0 1-2.2 2A17.6 17.6 0 0 1 3.2 5.7a2 2 0 0 1 2-2.2Z" />}
  {name === 'whatsapp' && (
    <>
      <path d="M3.6 20.4 4.8 16A8.6 8.6 0 1 1 8 19.2Z" />
      <path d="M9 8.3c.2-.5.5-.5.8-.5h.6c.2 0 .4 0 .6.5l.7 1.6c.1.2 0 .4-.1.6l-.5.6c-.1.1-.2.3 0 .5a6.3 6.3 0 0 0 2.9 2.6c.2.1.4.1.5-.1l.7-.8c.2-.2.4-.2.6-.1l1.6.8c.2.1.4.2.4.4 0 .5-.2 1.2-.7 1.6-.5.4-1.4.7-2.3.5a9.7 9.7 0 0 1-5.6-4.9c-.6-1.1-.6-2.4.1-3.3Z" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'menu' && <path d="M3.5 7.5h17M3.5 16.5h17" />}
  {name === 'close' && <path d="M5.5 5.5l13 13M18.5 5.5l-13 13" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'check' && <path d="M5 12.5 9.5 17 19 7.5" />}
  {name === 'mail' && <><rect x="3.5" y="5.5" width="17" height="13" rx="1.5" /><path d="m4 7 8 6 8-6" /></>}
  {name === 'alert' && <><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5v5.5M12 16.2v.3" /></>}
</svg>
