---
/** Small interface icons (1.5px line, 24px grid). Decorative unless `label` is set. */
interface Props {
  name: 'arrow' | 'phone' | 'whatsapp' | 'menu' | 'close' | 'plus' | 'check' | 'mail' | 'alert' | 'chevron' | 'headset' | 'calendar' | 'chat' | 'eye' | 'lock' | 'chart' | 'wrench' | 'camera' | 'bell' | 'key' | 'power' | 'door' | 'gear' | 'user' | 'list' | 'pin' | 'note' | 'home' | 'building' | 'factory' | 'grid' | 'cctv' | 'intercom' | 'campus' | 'run' | 'car' | 'box' | 'monitor' | 'search';
  strokeWidth?: number;
  size?: number;
  label?: string;
  class?: string;
}
const { name, size = 18, label, class: className, strokeWidth = 1.6 } = Astro.props;
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {name === 'arrow' && <path d="M4 12h15M13.5 6.5 19 12l-5.5 5.5" />}
  {name === 'phone' && <path d="M5.2 3.5h3.2l1.6 4.3-2.1 1.4a11.6 11.6 0 0 0 6.9 6.9l1.4-2.1 4.3 1.6v3.2a2 2 0 0 1-2.2 2A17.6 17.6 0 0 1 3.2 5.7a2 2 0 0 1 2-2.2Z" />}
  {name === 'whatsapp' && (
    <>
      <path d="M3.6 20.4 4.8 16A8.6 8.6 0 1 1 8 19.2Z" />
      <path d="M9 8.3c.2-.5.5-.5.8-.5h.6c.2 0 .4 0 .6.5l.7 1.6c.1.2 0 .4-.1.6l-.5.6c-.1.1-.2.3 0 .5a6.3 6.3 0 0 0 2.9 2.6c.2.1.4.1.5-.1l.7-.8c.2-.2.4-.2.6-.1l1.6.8c.2.1.4.2.4.4 0 .5-.2 1.2-.7 1.6-.5.4-1.4.7-2.3.5a9.7 9.7 0 0 1-5.6-4.9c-.6-1.1-.6-2.4.1-3.3Z" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'menu' && <path d="M3.5 7.5h17M3.5 16.5h17" />}
  {name === 'close' && <path d="M5.5 5.5l13 13M18.5 5.5l-13 13" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'check' && <path d="M5 12.5 9.5 17 19 7.5" />}
  {name === 'mail' && <><rect x="3.5" y="5.5" width="17" height="13" rx="1.5" /><path d="m4 7 8 6 8-6" /></>}
  {name === 'chevron' && <path d="m6.5 9.5 5.5 5.5 5.5-5.5" />}
  {name === 'headset' && <><path d="M4.5 14v-2a7.5 7.5 0 0 1 15 0v2" /><rect x="3.5" y="13" width="4" height="6" rx="1.5" /><rect x="16.5" y="13" width="4" height="6" rx="1.5" /><path d="M18.5 19c0 1.7-1.6 2.5-4 2.5h-1.5" /></>}
  {name === 'calendar' && <><rect x="3.5" y="5" width="17" height="15.5" rx="2" /><path d="M3.5 9.5h17M8 3v4M16 3v4" /><path d="M7.5 13h.01M12 13h.01M16.5 13h.01M7.5 16.5h.01M12 16.5h.01M16.5 16.5h.01" stroke-width="2.2" /></>}
  {name === 'chat' && <><path d="M4 5.5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H10l-4.5 3.5V17.5H4a1 1 0 0 1-1-1v-10a1 1 0 0 1 1-1Z" /><path d="M7.5 10h9M7.5 13.5h6" /></>}
  {name === 'eye' && <><path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /></>}
  {name === 'lock' && <><rect x="5" y="10.5" width="14" height="10.5" rx="1.5" /><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3M12 14.5v2.5" /></>}
  {name === 'chart' && <path d="M5 20.5V13h3.5v7.5M10.25 20.5V8.5h3.5v12M15.5 20.5V4h3.5v16.5" />}
  {name === 'wrench' && <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.8-3.8a6 6 0 0 1-7.9 7.9l-6.9 6.9a2.1 2.1 0 0 1-3-3l6.9-6.9a6 6 0 0 1 7.9-7.9z" />}
  {name === 'camera' && <><rect x="3" y="6" width="18" height="12.5" rx="2" /><circle cx="12" cy="12.25" r="2.6" /><path d="M6 9h.01" stroke-width="2.2" /></>}
  {name === 'bell' && <><path d="M6 16.5V11a6 6 0 0 1 12 0v5.5l1.5 2h-15Z" /><path d="M10 21a2.2 2.2 0 0 0 4 0" /></>}
  {name === 'key' && <><circle cx="8" cy="15" r="4.5" /><path d="m11.2 11.8 8.3-8.3M16.5 6.5l2.5 2.5M14 9l2 2" /></>}
  {name === 'power' && <><path d="M12 3v9" /><path d="M7.2 6.4a7.5 7.5 0 1 0 9.6 0" /></>}
  {name === 'door' && <><rect x="5.5" y="3" width="13" height="18" rx="1" /><path d="M9 3v18M14.5 11.5v1.5" /></>}
  {name === 'gear' && <><circle cx="12" cy="12" r="3" /><path d="M12 2.8v2.4M12 18.8v2.4M21.2 12h-2.4M5.2 12H2.8M18.5 5.5l-1.7 1.7M7.2 16.8l-1.7 1.7M18.5 18.5l-1.7-1.7M7.2 7.2 5.5 5.5" /><circle cx="12" cy="12" r="6.3" /></>}
  {name === 'user' && <><circle cx="12" cy="8" r="3.8" /><path d="M4.5 20.5c.8-4 3.8-6 7.5-6s6.7 2 7.5 6" /></>}
  {name === 'list' && <path d="M9 6.5h11M9 12h11M9 17.5h11M4.5 6.5h.01M4.5 12h.01M4.5 17.5h.01" />}
  {name === 'pin' && <><path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.4" /></>}
  {name === 'note' && <><path d="M6 3h8.5L19 7.5V21H6Z" /><path d="M14 3v5h5M9 12.5h6.5M9 16h6.5" /></>}
  {name === 'home' && <><path d="M4 10.5 12 4l8 6.5V20H4Z" /><path d="M10 20v-5.5h4V20" /></>}
  {name === 'building' && <><rect x="5" y="3.5" width="14" height="17" rx="1" /><path d="M9 7.5h1.5M13.5 7.5H15M9 11h1.5M13.5 11H15M9 14.5h1.5M13.5 14.5H15M10.5 20.5V18h3v2.5" /></>}
  {name === 'factory' && <><path d="M3.5 20.5V11l5 3V11l5 3V7h4l1 13.5Z" /><path d="M7 17.5h2M11.5 17.5h2" /></>}
  {name === 'grid' && <><rect x="4" y="4" width="6.5" height="6.5" rx="1" /><rect x="13.5" y="4" width="6.5" height="6.5" rx="1" /><rect x="4" y="13.5" width="6.5" height="6.5" rx="1" /><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1" /></>}
  {name === 'cctv' && <><path d="M3.5 7.5 17 5l1.2 5.5L4.7 13Z" /><path d="M18.2 8.2 21 7.6M10 12l1 4.5H6.5M6.5 14v5" /><circle cx="14.6" cy="8.4" r="1.1" /></>}
  {name === 'intercom' && <><rect x="5" y="3" width="14" height="18" rx="1.5" /><rect x="8" y="6" width="8" height="6" rx="0.5" /><path d="M9 15.5h.01M12 15.5h.01M15 15.5h.01M9 18h.01M12 18h.01M15 18h.01" stroke-width="2" /></>}
  {name === 'campus' && <><path d="M3.5 20.5h17M5 20.5V11h14v9.5M3.5 11 12 6l8.5 5M12 6V3.5h3" /><path d="M8 14h1.5M14.5 14H16M8 17h1.5M14.5 17H16M11 20.5v-4h2v4" /></>}
  {name === 'run' && <><circle cx="14.5" cy="4.5" r="1.8" /><path d="m7 21 3.5-5.5 3 2.5V22M10.5 15.5 12 9l-3.5 1.5L7 13.5M12 9l3 2.5 3 .5M12.5 11.5l2.5 3" /></>}
  {name === 'car' && <><path d="M4 16.5V12l2-5h12l2 5v4.5M4 12h16" /><rect x="3" y="16" width="18" height="2.5" rx="1" /><path d="M7.5 14.3h.01M16.5 14.3h.01M5.5 18.5V20M18.5 18.5V20" stroke-width="2" /></>}
  {name === 'box' && <><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9Z" /><path d="m4 7.5 8 4.5 8-4.5M12 12v9" /></>}
  {name === 'monitor' && <><rect x="3" y="4.5" width="18" height="12" rx="1.5" /><path d="M9 20.5h6M12 16.5v4" /></>}
  {name === 'search' && <><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 5 5" /></>}
  {name === 'alert' && <><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5v5.5M12 16.2v.3" /></>}
</svg>
