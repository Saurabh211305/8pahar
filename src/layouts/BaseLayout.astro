---
import '@fontsource-variable/manrope/wght.css';
import '@fontsource-variable/newsreader/opsz.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { business } from '../config/business';

interface Props {
  title: string;
  description: string;
  /** Exclude from search results (e.g. draft legal pages, 404). */
  noindex?: boolean;
  /** JSON-LD objects to embed. */
  structuredData?: Record<string, unknown>[];
  /** Hero image to preload: [srcset, sizes]. */
  preloadImage?: { srcset: string; sizes: string; href: string };
}

const { title, description, noindex = false, structuredData = [], preloadImage } = Astro.props;
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).toString() : null;
const ogImage = site ? new URL('/og-image.jpg', site).toString() : '/og-image.jpg';
const gtmId = business.gtmId;
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#F4EFE7" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/brand/icon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {site && <link rel="sitemap" href="/sitemap-index.xml" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="8PAHAR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="8PAHAR — Intelligent Security Systems. Owl logo with the line: Fewer blind spots. Security designed around your property." />
    <meta property="og:locale" content="en_IN" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />

    {preloadImage && <link rel="preload" as="image" href={preloadImage.href} imagesrcset={preloadImage.srcset} imagesizes={preloadImage.sizes} fetchpriority="high" />}

    <script is:inline>document.documentElement.classList.add('js');</script>

    {structuredData.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

    {gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        (function (w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName(s)[0], j = d.createElement(s);
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + encodeURIComponent(i);
          f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', gtmId);
      </script>
    )}
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <slot name="after" />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
